# Copy to .env and fill in. .env is gitignored; never commit real keys.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Optional overrides (defaults live in src/research_agent/config.py).
# Confirm exact IDs first: uv run python scripts/list_models.py
# RESEARCH_STRONG_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
# RESEARCH_FAST_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# RESEARCH_DB_PATH=research.db

# Optional, for identifier checks (PubMed E-utilities). Without a key NCBI allows 3 requests/s; with one, 10/s.
# NCBI_API_KEY=
# Optional contact address sent to NCBI and Crossref (their "polite pool"). Leave empty to send none.
# RESEARCH_CONTACT_EMAIL=

# Cloud deployment (compose.yaml). APP_PASSWORD is required there; DOMAIN only for the https profile.
# APP_PASSWORD=
# DOMAIN=briefs.example.org
